{
    "manifest_version": 3,
    "name": "Rilog DevTools",
    "version": "0.0.1",
    "description": "Advanced request/click/input/console inspector for any site, with custom capture rules and Rilog integration.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "src/popup/index.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png"
        }
    },
    "options_page": "src/options/index.html",
    "devtools_page": "src/devtools/devtools.html",
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["src/content/capture.ts"],
            "world": "MAIN",
            "run_at": "document_start",
            "all_frames": true
        },
        {
            "matches": ["<all_urls>"],
            "js": ["src/content/bridge.ts"],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "permissions": ["storage", "notifications"],
    "host_permissions": ["<all_urls>"]
}
